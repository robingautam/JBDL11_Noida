<html>
<body>
<h2>Hello World!</h2>


<form action="login" method="post">
    <label>
      Name:
      <input type="text" name="name" required>
    </label>
    <br><br>

    <label>
      Email:
      <input type="email" name="email" required>
    </label>
    <br><br>

    <label>
      Message:
      <br>
      <textarea name="message" rows="4" cols="30" required></textarea>
    </label>
    <br><br>

    <button type="submit">Submit</button>
  </form>

</body>
</html>
